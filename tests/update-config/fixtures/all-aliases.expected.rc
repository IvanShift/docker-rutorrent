catch = {"system.file_name.allow_legacy_utf8.set=0"}
# Native legacy aliases and safe supported limit values.
dht.override_port.set = 6881
dht.override_port.set = 6882
protocol.encryption.set = allow
execute.nothrow = echo,hello
schedule = example,0,60,"execute.nothrow=echo,hello"
schedule.remove = example
dht.mode.set = off
network.bind_address.set = 127.0.0.1
network.local_address.set = 192.0.2.1
network.scgi.open_local = /run/rtorrent/rtorrent.sock
network.scgi.open_port = 127.0.0.1:5000
network.proxy.global.set = http://127.0.0.1:8080
keys.layout.set = qwerty
ui.torrent_list.layout.set = full
system.sockets.max_size.set = 65536
system.sockets.files.max_alloc.set = 8192
system.sockets.http.max_alloc.set = 512
system.sockets.http.max_alloc.set = 512
system.sockets.http.max_alloc.set = 512
system.sockets.files.min_alloc.set=8192
system.sockets.http.min_alloc.set=512
pieces.memory.max.set = 1G
execute.nothrow.bg = {sh,-c,/usr/bin/php85 /rutorrent/app/php/initplugins.php torrent}
method.set_key = event.download.finished,postdl,"execute.nothrow=/usr/local/bin/postdl,$d.base_path="

# Recalculate socket allocations after per-category limits.
system.sockets.adjust_alloc =
