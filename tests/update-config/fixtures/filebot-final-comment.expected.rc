catch = {"system.file_name.allow_legacy_utf8.set=1"}
dht.mode.set = off
# operator note: no newline after this comment
method.set_key = event.system.shutdown,docker_rutorrent_early_save,"session.save="
method.set_key = event.download.finished,filebot,"execute.nothrow=/usr/local/bin/postdl,$d.base_path=,$d.name="
method.set_key = event.download.erased,filebot_cleaner,"execute.nothrow=/usr/local/bin/postrm"
