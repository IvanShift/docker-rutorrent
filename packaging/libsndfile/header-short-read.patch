+static sf_count_t
+short_header_read (void *ptr, sf_count_t count, void *user_data)
+{
+	const sf_count_t result = *((sf_count_t *) user_data) ;
+	if (result > 0 && count > 0)
+		((unsigned char *) ptr) [0] = 0x55 ;
+	return result ;
+} /* short_header_read */
+
+static void
+short_read_conversion_test (char endian, char field, sf_count_t result)
+{
+	SF_PRIVATE sf_private, *psf = &sf_private ;
+	union { unsigned int i ; unsigned short s ; sf_count_t c ; float f ; double d ; } value ;
+	unsigned int first = 0 ;
+	char format [4] = { endian, '4', field, 0 } ;
+	int bytes, failed = 0 ;
+
+	memset (psf, 0, sizeof (*psf)) ;
+	psf->header.len = 64 ;
+	psf->header.end = 4 ;
+	psf->header.ptr = calloc (1, psf->header.len) ;
+	if (psf->header.ptr == NULL)
+	{	puts ("Failed to allocate short-read fixture.") ;
+		exit (1) ;
+		} ;
+	memcpy (psf->header.ptr, "ABCD", 4) ;
+	psf->virtual_io = 1 ;
+	psf->vio.read = short_header_read ;
+	psf->vio_user_data = &result ;
+	memset (&value, 0x55, sizeof (value)) ;
+
+	switch (field)
+	{	case 'm' :
+		case 'h' :
+		case '3' :
+		case '4' :
+			bytes = psf_binheader_readf (psf, format, &first, &value.i) ;
+			failed = value.i != 0 ;
+			break ;
+		case '2' :
+			bytes = psf_binheader_readf (psf, format, &first, &value.s) ;
+			failed = value.s != 0 ;
+			break ;
+		case '8' :
+			bytes = psf_binheader_readf (psf, format, &first, &value.c) ;
+			failed = value.c != 0 ;
+			break ;
+		case 'f' :
+			bytes = psf_binheader_readf (psf, format, &first, &value.f) ;
+			failed = value.f != 0.0f ;
+			break ;
+		case 'd' :
+			bytes = psf_binheader_readf (psf, format, &first, &value.d) ;
+			failed = value.d != 0.0 ;
+			break ;
+		default :
+			free (psf->header.ptr) ;
+			exit (1) ;
+		} ;
+	free (psf->header.ptr) ;
+	if (failed || first != (endian == 'E' ? 0x41424344u : 0x44434241u) || bytes != 4 + result)
+	{	printf ("Short-read conversion failed: endian=%c field=%c result=%d\n", endian, field, (int) result) ;
+		exit (1) ;
+		} ;
+} /* short_read_conversion_test */
+
 void
 test_conversions (void)
 {
 	conversion_test ('E') ;
 	conversion_test ('e') ;
+	for (const char *field = "mh2348fd" ; *field ; field++)
+		for (sf_count_t result = -1 ; result <= 1 ; result++)
+		{	short_read_conversion_test ('E', *field, result) ;
+			short_read_conversion_test ('e', *field, result) ;
+			} ;
+	puts ("Short-read conversions: ok") ;
 } /* test_conversion */
 
