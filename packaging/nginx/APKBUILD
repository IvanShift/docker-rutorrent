# Core-only adaptation of Alpine aports main/nginx at
# 9063366e892fed73e7a9ec6879d22d5510a7bf32 (3.24-stable, 1.30.4-r1).
# Contributors: Jeff Bilyk, Bartłomiej Piotrowski and Jakub Jirutka.
# Upstream maintainer: Jakub Jirutka <jakub@jirutka.cz>.
# Builds only the nginx package: the statically compiled module set, install
# scripts and file layout of Alpine's package, without nginx-mod-*, nginx-debug,
# nginx-openrc, nginx-vim or nginx-mod-dev. Upgrade only to stable (even minor)
# releases. Version and source checksum are supplied by the Dockerfile build
# arguments; the auxiliary files are byte-identical to the aports commit above.
pkgname=nginx
pkgver="${NGINX_VERSION:?Set NGINX_VERSION}"
pkgrel=0
provider_priority=100
pkgdesc="HTTP and reverse proxy server (stable version)"
url="https://www.nginx.org/"
arch="all"
license="BSD-2-Clause"
makedepends="linux-headers openssl-dev pcre2-dev zlib-dev"
pkgusers="nginx"
_grp_ngx="nginx"
_grp_www="www-data"
pkggroups="$_grp_ngx $_grp_www"
install="$pkgname.pre-install $pkgname.post-install $pkgname.pre-upgrade $pkgname.post-upgrade"
subpackages="$pkgname-doc"
source="https://nginx.org/download/nginx-$pkgver.tar.gz
	no-werror.patch
	nginx.conf
	default.conf
	$pkgname.logrotate
	"

# secfixes (since Alpine's 1.30.4-r1; earlier entries are in the aports recipe):
#   1.30.6-r0:
#     - CVE-2026-15176
#     - CVE-2026-93479
#     - CVE-2026-95101
#     - CVE-2026-97629
#     - CVE-2026-97205
#   1.30.5-r0:
#     - CVE-2026-90439

_modules_dir="usr/lib/$pkgname/modules"

build() {
	# Same configure arguments as Alpine's core binary; the =dynamic modules,
	# their stream/mail submodule flags, the perl module path and third-party
	# --add-dynamic-module sources are omitted because they only produce
	# nginx-mod-* packages.
	./configure \
		--prefix=/var/lib/$pkgname \
		--sbin-path=/usr/sbin/$pkgname \
		--modules-path=/$_modules_dir \
		--conf-path=/etc/$pkgname/$pkgname.conf \
		--pid-path=/run/$pkgname/$pkgname.pid \
		--lock-path=/run/$pkgname/$pkgname.lock \
		--http-client-body-temp-path=/var/lib/$pkgname/tmp/client_body \
		--http-proxy-temp-path=/var/lib/$pkgname/tmp/proxy \
		--http-fastcgi-temp-path=/var/lib/$pkgname/tmp/fastcgi \
		--http-uwsgi-temp-path=/var/lib/$pkgname/tmp/uwsgi \
		--http-scgi-temp-path=/var/lib/$pkgname/tmp/scgi \
		\
		--user=$pkgusers \
		--group=$_grp_ngx \
		--with-threads \
		--with-file-aio \
		--with-compat \
		\
		--with-http_ssl_module \
		--with-http_v2_module \
		--with-http_v3_module \
		--with-http_realip_module \
		--with-http_addition_module \
		--with-http_sub_module \
		--with-http_dav_module \
		--with-http_flv_module \
		--with-http_mp4_module \
		--with-http_gunzip_module \
		--with-http_gzip_static_module \
		--with-http_auth_request_module \
		--with-http_random_index_module \
		--with-http_secure_link_module \
		--with-http_degradation_module \
		--with-http_slice_module \
		--with-http_stub_status_module
	make
}

check() {
	# The nginx-tests suite was run when this recipe was prepared; startup runs
	# nginx -t on the image configuration and tests/smoke drive the daemon.
	./objs/nginx -V
}

package() {
	make DESTDIR="$pkgdir" install
	chown root:root "$pkgdir"/usr/sbin/nginx

	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
	install -Dm644 README.md "$pkgdir"/usr/share/doc/$pkgname/README.md

	install -Dm644 objs/$pkgname.8 "$pkgdir"/usr/share/man/man8/$pkgname.8

	cd "$pkgdir"

	install -Dm644 "$srcdir"/nginx.conf ./etc/$pkgname/nginx.conf
	install -dm755 ./etc/$pkgname/http.d ./etc/$pkgname/modules

	install -Dm644 "$srcdir"/$pkgname.logrotate ./etc/logrotate.d/$pkgname

	install -dm750 -o $pkgusers -g $_grp_ngx ./var/lib/$pkgname
	install -dm700 -o $pkgusers -g $_grp_ngx ./var/lib/$pkgname/tmp
	install -dm755 -g $_grp_www ./var/www/localhost/htdocs

	install -Dm644 "$srcdir"/default.conf ./usr/share/$pkgname/http-default_server.conf

	install -dm755 ./var/log
	mv ./var/lib/$pkgname/logs ./var/log/$pkgname
	chown $pkgusers:$_grp_ngx var/log/$pkgname

	# Without dynamic modules make install does not create this directory;
	# Alpine's package keeps it as the target of /var/lib/nginx/modules.
	install -dm755 ./$_modules_dir
	ln -sf /$_modules_dir ./var/lib/$pkgname/modules
	ln -sf /var/log/$pkgname ./var/lib/$pkgname/logs
	ln -sf /run/$pkgname ./var/lib/$pkgname/run

	# Remove archaic charset maps.
	rm ./etc/$pkgname/koi-* ./etc/$pkgname/win-utf

	rm -rf ./run ./etc/$pkgname/*.default
}

