# CLI-only adaptation of Alpine aports community/mediainfo.
# Upstream contributor and maintainer: Jakub Jirutka <jakub@jirutka.cz>.
# Sources and checksums follow the same 26.05 release as libmediainfo.
pkgname=mediainfo
pkgver="${MEDIAINFO_VERSION:?Set MEDIAINFO_VERSION}"
pkgrel=0
pkgdesc="Supplies technical and tag information about media files (CLI)"
url="https://mediaarea.net/en/MediaInfo"
arch="all"
license="BSD-2-Clause"
makedepends="autoconf automake libmediainfo-dev~$pkgver libtool libzen-dev"
source="https://mediaarea.net/download/source/mediainfo/$pkgver/mediainfo_$pkgver.tar.xz"
builddir="$srcdir/MediaInfo/Project/GNU/CLI"
sha512sums="${MEDIAINFO_SHA512:?Set MEDIAINFO_SHA512}  mediainfo_$pkgver.tar.xz"

prepare() {
	default_prepare
	sh ./autogen.sh
}

build() {
	./configure \
		--build="$CBUILD" \
		--host="$CHOST" \
		--prefix=/usr \
		--libdir=/usr/lib \
		--sysconfdir=/etc \
		--enable-static=no
	make -j"$JOBS"
}

check() {
	./mediainfo --Version
}

package() {
	make DESTDIR="$pkgdir" install
}
