Local test-only coverage for the two upstream print-depth guards.
Use empty nodes and the existing private printbuffer; no deep input.

--- a/tests/misc_tests.c
+++ b/tests/misc_tests.c
@@ -799,6 +799,48 @@
     cJSON_Delete(valid_big_number_json_object2);
 }
 
+/* Exercise the print-depth boundary with empty nodes, without recursion. */
+static void assert_print_depth_boundary(int type,
+    cJSON_bool (*print_container)(const cJSON * const, printbuffer * const),
+    const char *expected)
+{
+    cJSON item;
+    unsigned char output[5] = "keep";
+    printbuffer buffer = { 0, 0, 0, 0, 0, 0, { 0, 0, 0 } };
+    size_t depth;
+
+    memset(&item, 0, sizeof(item));
+    item.type = type;
+    buffer.buffer = output;
+    buffer.length = sizeof(output);
+    buffer.noalloc = true;
+    buffer.hooks = global_hooks;
+
+    for (depth = CJSON_NESTING_LIMIT; depth <= CJSON_NESTING_LIMIT + 1; depth++)
+    {
+        buffer.depth = depth;
+        TEST_ASSERT_FALSE(print_container(&item, &buffer));
+        TEST_ASSERT_EQUAL_STRING("keep", output);
+        TEST_ASSERT_EQUAL_UINT(0, buffer.offset);
+        TEST_ASSERT_EQUAL_UINT(depth, buffer.depth);
+    }
+
+    buffer.depth = CJSON_NESTING_LIMIT - 1;
+    TEST_ASSERT_TRUE(print_container(&item, &buffer));
+    TEST_ASSERT_EQUAL_STRING(expected, output);
+    TEST_ASSERT_EQUAL_UINT(CJSON_NESTING_LIMIT - 1, buffer.depth);
+}
+
+static void cjson_print_array_should_respect_depth_boundary(void)
+{
+    assert_print_depth_boundary(cJSON_Array, print_array, "[]");
+}
+
+static void cjson_print_object_should_respect_depth_boundary(void)
+{
+    assert_print_depth_boundary(cJSON_Object, print_object, "{}");
+}
+
 int CJSON_CDECL main(void)
 {
     UNITY_BEGIN();
