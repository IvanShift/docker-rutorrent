# Based on Alpine aports main/curl in 3.24-stable at
# ab53c408436ac7199ed5b67bde204aaca73003bd, the commit the v3.24 APKINDEX
# records for curl 8.22.0-r0. aports master packages 8.23.0 with the same
# recipe; only the version, secfixes and checksum differ.
# Upstream contributors: Sergei Lukin, Valery Kartel and Łukasz Jendrysik.
# Alpine maintainer: Achill Gilgenast <achill@achill.org>.
# Version and source checksum are supplied by the Dockerfile build arguments.
# Local changes: no -dbg, -static, zsh or fish completion subpackages and no
# bootstrap branches. Features, dependencies, package names and provides are
# unchanged, so v3.24 consumers of so:libcurl.so.4 resolve to this libcurl.
pkgname=curl
pkgver="${CURL_VERSION:?Set CURL_VERSION}"
pkgrel=0
pkgdesc="URL retrieval utility and library"
url="https://curl.se/"
arch="all"
license="curl"
depends="ca-certificates-bundle"
depends_dev="
	brotli-dev
	c-ares-dev
	libidn2-dev
	libpsl-dev
	nghttp2-dev
	openssl-dev>3
	zlib-dev
	zstd-dev
	"
checkdepends="nghttp2 python3"
makedepends_host="$depends_dev"
makedepends_build="groff perl"
subpackages="$pkgname-doc $pkgname-dev libcurl"
source="https://curl.se/download/curl-$pkgver.tar.xz"
options="net" # Required for running tests
provides="wcurl=$pkgver-r$pkgrel"
replaces="wcurl"
sha512sums="${CURL_SHA512:?Set CURL_SHA512}  curl-$pkgver.tar.xz"

build() {
	./configure \
		--build=$CBUILD \
		--host=$CHOST \
		--prefix=/usr \
		--enable-ares \
		--enable-ipv6 \
		--enable-unix-sockets \
		--disable-static \
		--with-libidn2 \
		--with-nghttp2 \
		--with-openssl \
		--with-ca-bundle=/etc/ssl/certs/ca-certificates.crt \
		--with-ca-path=/etc/ssl/certs \
		--without-zsh-functions-dir \
		--without-fish-functions-dir \
		--disable-ldap \
		--with-pic \
		--enable-websockets \
		--without-libssh2 # https://bugs.alpinelinux.org/issues/10222
	make
}

check() {
	make -C tests
	make -j1 -C tests TFLAGS="-j$JOBS" nonflaky-test
}

package() {
	# depends on exactly the same build of libcurl
	depends="libcurl=$pkgver-r$pkgrel"

	make install DESTDIR="$pkgdir"
}

libcurl() {
	pkgdesc="The multiprotocol file transfer library"

	amove usr/lib
}

dev() {
	default_dev
	# Used by trurl
	install -Dm755 -t "$subpkgdir"/usr/bin "$builddir"/scripts/cd2nroff
}
