# Keep persisted paths stable on 0.16.25; catch also permits older daemon images.
catch = {"system.file_name.allow_legacy_utf8.set=0"}

# logs
log.open_file.flush = "rtorrent", "/tmp/rtorrent.log"
log.add_output = "error", "rtorrent"

# general
system.daemon.set = true
directory.default.set = "<DOWNLOAD_DIRECTORY>"
session.path.set = /data/.session
protocol.encryption.set = allow

# network
network.scgi.open_local = /run/rtorrent/rtorrent.sock
schedule = chmod_scgi_socket,0,0,"execute.nothrow=chmod,600,/run/rtorrent/rtorrent.sock"
network.listen.port.range.set = <PORT_RTORRENT>-<PORT_RTORRENT>
network.listen.port.random.set = no
# startup detects IPv6 support before seeding a new persistent configuration.
network.prefer.ipv6.set = yes
network.block.ipv6.set = <BLOCK_IPV6>
pieces.hash.on_completion.set = no

dht.mode.set = <MODE_DHT>
dht.override_port.set = <PORT_DHT>
protocol.pex.set = <PEER_EXCHANGE>
throttle.min_peers.normal.set = 1
throttle.max_peers.normal.set = 100
throttle.min_peers.seed.set = 1
throttle.max_peers.seed.set = 50
throttle.max_uploads.set = 15

# scheduling
execute.nothrow.bg = {sh,-c,/usr/bin/php85 /rutorrent/app/php/initplugins.php torrent}
schedule = watch_directory,1,10,"load.start=/data/.watch/*.torrent"
# Stops every tied torrent whose source file disappeared, regardless of directory.
schedule = untied_directory,1,10,"stop_untied="
schedule = low_diskspace,15,60,close_low_diskspace=1000M
