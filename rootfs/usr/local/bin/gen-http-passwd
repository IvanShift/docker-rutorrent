#!/usr/bin/env sh

set -eu

file=/config/nginx/passwd/rutorrent_passwd
lock=/run/rutorrent-passwd.lock
. /usr/local/libexec/atomic-file.sh

printf 'Username: '
if ! IFS= read -r username; then
  printf 'Unable to read username\n' >&2
  exit 1
fi

case "${username}" in
  ''|*[!A-Za-z0-9._-]*)
    printf 'Username must contain only A-Z, a-z, digits, dot, underscore, or hyphen\n' >&2
    exit 64
  ;;
esac

# Startup already secured the root-owned ancestor chain. Refuse stale or
# substituted paths before prompting for a password or reading existing data.
/usr/bin/php85 /usr/local/lib/rutorrent/startup.php auth-check
umask 077
passwd=$(openssl passwd -6)
# Concurrent runs serialize from reading the current file through publication,
# after the password is entered. The umask creates a missing lock as root 0600,
# the only lock the helper admits.
exec 9<>"${lock}"
/usr/local/libexec/service-runtime lock-auth 9
temporary_path=$(mktemp "${file}.tmp.XXXXXX")

existing=false
if [ -e "${file}" ]; then
  if awk -F: -v username="${username}" '("x" $1) == ("x" username) { found = 1 } END { exit !found }' "${file}"; then
    existing=true
  fi

  awk -F: -v username="${username}" -v passwd="${passwd}" '
    ("x" $1) == ("x" username) {
      print username ":" passwd
      found = 1
      next
    }
    { print }
    END {
      if (!found) {
        print username ":" passwd
      }
    }
  ' "${file}" > "${temporary_path}"
else
  printf '%s:%s\n' "${username}" "${passwd}" > "${temporary_path}"
fi

chown "0:${GID}" "${temporary_path}"
chmod 0640 "${temporary_path}"
/usr/local/libexec/service-runtime publish-auth "${temporary_path##*/}"
temporary_path=''
exec 9<&-

if [ "${existing}" = true ]; then
  printf 'The password has been updated for the http user: %s\n' "${username}"
else
  printf 'The password was generated for the http user: %s\n' "${username}"
fi
