#!/usr/bin/env sh
set -eu
# rTorrent waits for this erase hook, so it only requests one coalesced
# /data/media cleanup from the filebot-queue service.
if [ "$(id -u)" -eq 0 ]; then
  case "${UID:-}" in ''|*[!0-9]*) echo 'FileBot cleaner requires a configured non-root service identity' >&2; exit 78 ;; esac
  [ "${#UID}" -le 10 ] && [ "$UID" -gt 0 ] && [ "$UID" -le 4294967294 ] && [ -n "${GID:-}" ] || { echo 'FileBot cleaner requires a configured non-root service identity' >&2; exit 78; }
  exec su-exec "$UID:$GID" /usr/local/bin/postrm "$@"
fi
exec /usr/bin/php85 -n /usr/local/libexec/filebot-queue.php cleanup
