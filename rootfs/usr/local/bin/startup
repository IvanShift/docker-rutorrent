#!/usr/bin/env sh

set -eu

CSI="\033["
CEND="${CSI}0m"
CRED="${CSI}1;31m"
CGREEN="${CSI}1;32m"
CYELLOW="${CSI}1;33m"
CBLUE="${CSI}1;34m"

f_log() {
  LOG_TYPE="${1}"
  LOG_MESSAGE="${2}"

  case "${LOG_TYPE}" in
    "INF")
      echo -en "${CBLUE}[$(date +%Y/%m/%d-%H:%M:%S)] ${LOG_MESSAGE}${CEND}"
    ;;
    "SUC")
      echo -e "${CGREEN}${LOG_MESSAGE}${CEND}"
    ;;
    "WRN")
      echo -e "${CYELLOW}[$(date +%Y/%m/%d-%H:%M:%S)] ${LOG_MESSAGE}${CEND}"
    ;;
    "ERR")
      echo -e "${CRED}[$(date +%Y/%m/%d-%H:%M:%S)] ${LOG_MESSAGE}${CEND}"
    ;;
  esac
}

case "${ENABLE_RPC2}" in
  true)
    rpc2_mode=enabled
  ;;
  false)
    rpc2_mode=disabled
  ;;
  *)
    f_log ERR "ENABLE_RPC2 must be exactly true or false"
    exit 64
  ;;
esac

case "${HTTP_AUTH}" in
  true) ;;
  false)
    if [ "${ALLOW_UNAUTHENTICATED_HTTP:-false}" != true ]; then
      f_log ERR "HTTP_AUTH=false requires ALLOW_UNAUTHENTICATED_HTTP=true; refusing unauthenticated access"
      exit 64
    fi
    f_log WRN "HTTP authentication is disabled by explicit opt-out; stored tracker credentials and cookies are exposed to clients that can reach port 8080"
    ;;
  *)
    f_log ERR "HTTP_AUTH must be exactly true or false"
    exit 64
    ;;
esac

f_log INF "Create torrent user... "

if ! getent group "${GID}" >/dev/null; then
  groupmod -g "${GID}" torrent
fi

existing_user="$(getent passwd "${UID}" | cut -d: -f1)"

if [ -z "${existing_user}" ]; then
  usermod -u "${UID}" -g "${GID}" torrent
elif [ "${existing_user}" = "torrent" ]; then
  usermod -g "${GID}" torrent
else
  f_log WRN "UID ${UID} already assigned to ${existing_user}; continuing with existing account"
fi

[ -d /home/torrent ] || mkdir -p /home/torrent
chown "${UID}:${GID}" /home/torrent
f_log SUC "done" # success of Create torrent user

f_log INF "Create volume folders... "
# Establish whether /config is a trusted name-owning parent before using
# absence as first-use evidence. Old profiles without a witness still start;
# their legacy queue is held visibly by the PHP admission guard.
config_trusted=false
if [ ! -L /config ] && [ -d /config ]; then
  config_owner=$(stat -c %u /config)
  config_mode=$(stat -c %a /config)
  if { [ "${config_owner}" = 0 ] || [ "${config_owner}" = "${UID}" ]; } \
    && [ "$((0${config_mode} & 022))" -eq 0 ]; then
    config_trusted=true
  fi
fi
# An absent config root is first-use evidence. An existing root can have lost
# an old group-writable erasedata queue, even if that queue is now absent.
new_rutorrent_config=false
if [ ! -e /config/rutorrent ] && [ ! -L /config/rutorrent ]; then
  new_rutorrent_config=true
fi
if [ "${new_rutorrent_config}" = true ] && [ "${config_trusted}" != true ]; then
  f_log ERR "Cannot attest erasedata queue root: /config is writable or foreign-owned"
  exit 78
fi
# Inspect durable stop-intent names before any /data chown can hide a foreign owner.
stop_intent_refuse() {
  f_log ERR "Cannot attest stop intent: $1"
  exit 78
}
for parent in /data /data/.session; do
  if [ "$parent" = /data/.session ] && [ ! -e "$parent" ] && [ ! -L "$parent" ]; then
    mkdir -m 0755 "$parent" || stop_intent_refuse "cannot create $parent"
  fi
  if [ -L "$parent" ] || [ ! -d "$parent" ]; then
    stop_intent_refuse "$parent is not a directory"
  fi
  metadata=$(stat -c '%u:%a' "$parent") || stop_intent_refuse "$parent cannot be inspected"
  owner=${metadata%%:*}
  mode=${metadata#*:}
  if { [ "$owner" != 0 ] && [ "$owner" != "${UID}" ]; } || [ "$((0${mode} & 022))" -ne 0 ]; then
    stop_intent_refuse "$parent is writable or foreign-owned"
  fi
done
stop_intent_dir=/data/.session/.rutorrent-stop-intents
if [ -e "$stop_intent_dir" ] || [ -L "$stop_intent_dir" ]; then
  if [ -L "$stop_intent_dir" ] || [ ! -d "$stop_intent_dir" ]; then
    stop_intent_refuse "$stop_intent_dir is not a directory"
  fi
  metadata=$(stat -c '%u:%a' "$stop_intent_dir") || stop_intent_refuse "$stop_intent_dir cannot be inspected"
  owner=${metadata%%:*}
  mode=${metadata#*:}
  if { [ "$owner" != 0 ] && [ "$owner" != "${UID}" ]; } || [ "$mode" != 700 ]; then
    stop_intent_refuse "$stop_intent_dir has unsafe ownership or mode"
  fi
  for entry in "$stop_intent_dir"/* "$stop_intent_dir"/.[!.]* "$stop_intent_dir"/..?*; do
    if [ ! -e "$entry" ] && [ ! -L "$entry" ]; then
      continue
    fi
    if [ -L "$entry" ] || [ ! -f "$entry" ]; then
      stop_intent_refuse "$entry is not a regular file"
    fi
    metadata=$(stat -c '%u:%a' "$entry") || stop_intent_refuse "$entry cannot be inspected"
    owner=${metadata%%:*}
    mode=${metadata#*:}
    if { [ "$owner" != 0 ] && [ "$owner" != "${UID}" ]; } || [ "$mode" != 600 ]; then
      stop_intent_refuse "$entry has unsafe ownership or mode"
    fi
  done
  # Root-provisioned private files are trusted; the daemon must own them even
  # when CHECK_PERM_DATA=false. Unverified entries never reach this chown.
  chown "${UID}:${GID}" "$stop_intent_dir"
  for entry in "$stop_intent_dir"/* "$stop_intent_dir"/.[!.]* "$stop_intent_dir"/..?*; do
    if [ -e "$entry" ]; then
      chown "${UID}:${GID}" "$entry"
    fi
  done
fi
mkdir -p /data/.watch /data/.session "${DOWNLOAD_DIRECTORY}"
mkdir -p /config/rtorrent /config/rutorrent /config/custom_themes /config/custom_plugins
if [ "${new_rutorrent_config}" = true ] || [ -e /config/rutorrent/erasedata-jobs ] || [ -L /config/rutorrent/erasedata-jobs ] || [ -e /config/rutorrent/.erasedata-first-use ] || [ -L /config/rutorrent/.erasedata-first-use ]; then
  # The later recursive chown would otherwise turn a foreign planted root
  # into a service-owned one. Validate before chown, while its owner is real.
  if [ "${config_trusted}" != true ]; then
    f_log ERR "Cannot attest erasedata queue root: /config is writable or foreign-owned"
    exit 78
  fi
  if [ -L /config/rutorrent ] || [ ! -d /config/rutorrent ]; then
    f_log ERR "Cannot attest erasedata queue root: /config/rutorrent is not a directory"
    exit 78
  fi
  root_owner=$(stat -c %u /config/rutorrent)
  root_mode=$(stat -c %a /config/rutorrent)
  if { [ "${root_owner}" != 0 ] && [ "${root_owner}" != "${UID}" ]; } \
    || [ "$((0${root_mode} & 022))" -ne 0 ]; then
    f_log ERR "Cannot attest erasedata queue root: /config/rutorrent is writable or foreign-owned"
    exit 78
  fi
  if [ -e /config/rutorrent/erasedata-jobs ] || [ -L /config/rutorrent/erasedata-jobs ]; then
    jobs_owner=$(stat -c %u /config/rutorrent/erasedata-jobs)
    jobs_mode=$(stat -c %a /config/rutorrent/erasedata-jobs)
    if [ -L /config/rutorrent/erasedata-jobs ] \
      || [ ! -d /config/rutorrent/erasedata-jobs ] \
      || { [ "${jobs_owner}" != 0 ] && [ "${jobs_owner}" != "${UID}" ]; } \
      || [ "$((0${jobs_mode} & 077))" -ne 0 ]; then
      f_log ERR "Cannot attest erasedata queue root: existing sibling is unsafe"
      exit 78
    fi
  fi
  if [ -e /config/rutorrent/.erasedata-first-use ] || [ -L /config/rutorrent/.erasedata-first-use ]; then
    marker_owner=$(stat -c %u /config/rutorrent/.erasedata-first-use)
    marker_mode=$(stat -c %a /config/rutorrent/.erasedata-first-use)
    if [ -L /config/rutorrent/.erasedata-first-use ] \
      || [ ! -f /config/rutorrent/.erasedata-first-use ] \
      || [ "${marker_owner}" != 0 ] || [ "${marker_mode}" != 400 ]; then
      f_log ERR "Cannot attest erasedata queue root: first-use witness is unsafe"
      exit 78
    fi
  elif [ "${new_rutorrent_config}" != true ] && [ -e /config/rutorrent/erasedata-jobs ]; then
    f_log ERR "Cannot attest erasedata queue root: pre-existing sibling lacks first-use witness"
    exit 78
  fi
fi
f_log SUC "done" # success of Create volume folders

f_log INF "Generate configuration... "

# Externalize rutorrent configuration
if [ -d /config/rutorrent/conf ]; then
  rm -rf /rutorrent/app/conf
  ln -s /config/rutorrent/conf /rutorrent/app/conf
else
  # Keep the proxy policy in the image unless the operator supplied an override.
  rm -f /rutorrent/app/conf/xmlrpc_proxy.php
  mv /rutorrent/app/conf /config/rutorrent
  ln -s /config/rutorrent/conf /rutorrent/app/conf
fi

# Restore newly shipped configuration without replacing persisted edits.
if [ -L /config/rutorrent/conf ]; then
  f_log WRN "conf is an operator symlink; skipping image comparison and seeding (update-config still runs)"
else
  find /rutorrent/conf-dist -type f | while IFS= read -r source; do
    relative="${source#/rutorrent/conf-dist/}"
    target="/config/rutorrent/conf/${relative}"
    parent="${target%/*}"
    while [ "${parent}" != /config/rutorrent/conf ]; do
      if [ -L "${parent}" ] || { [ -e "${parent}" ] && [ ! -d "${parent}" ]; }; then
        f_log WRN "conf/${relative} cannot be compared or seeded: parent is a symlink or not a directory"
        continue 2
      fi
      parent="${parent%/*}"
    done
    if [ -e "${target}" ] || [ -L "${target}" ]; then
      if ! cmp -s "${source}" "${target}"; then
        f_log WRN "conf/${relative} differs from image or is unreadable; keeping existing file"
      fi
    elif [ "${relative}" != xmlrpc_proxy.php ]; then
      mkdir -p "${target%/*}"
      cp -p "${source}" "${target}"
      chown "${UID}:${GID}" "${target}"
      f_log INF "seeded missing conf/${relative} from image"
    fi
  done
fi

# Externalize rutorrent share
if [ -d /config/rutorrent/share ]; then
  rm -rf /rutorrent/app/share
  ln -s /config/rutorrent/share /rutorrent/app/share
else
  mv /rutorrent/app/share /config/rutorrent
  ln -s /config/rutorrent/share /rutorrent/app/share
fi

# The application uses this owner-only sibling as a durable first-use witness
# and queue parent. Never create it for an existing config root: the legacy
# queue may have vanished while its old profile was group-writable.
if [ "${new_rutorrent_config}" = true ]; then
  mkdir -m 0700 /config/rutorrent/erasedata-jobs
  (umask 077; : > /config/rutorrent/.erasedata-first-use)
  chmod 0400 /config/rutorrent/.erasedata-first-use
fi

# Add custom plugins
for plugin_path in /config/custom_plugins/*; do
  [ -e "${plugin_path}" ] || continue
  plugin=${plugin_path##*/}
  plugin_target="/rutorrent/app/plugins/${plugin}"
  if [ ! -e "${plugin_target}" ] && [ ! -L "${plugin_target}" ]; then
    ln -s "${plugin_path}" "${plugin_target}"
  fi
done

# Add custom themes
for theme_path in /config/custom_themes/*; do
  [ -e "${theme_path}" ] || continue
  theme=${theme_path##*/}
  theme_target="/rutorrent/app/plugins/theme/themes/${theme}"
  if [ ! -e "${theme_target}" ] && [ ! -L "${theme_target}" ]; then
    ln -s "${theme_path}" "${theme_target}"
  fi
done

sed -e "s|<DOWNLOAD_DIRECTORY>|${DOWNLOAD_DIRECTORY}|g" -e "s|<MODE_DHT>|${MODE_DHT}|g" -e "s|<PORT_DHT>|${PORT_DHT}|g" -e "s|<PEER_EXCHANGE>|${PEER_EXCHANGE}|g" -e "s|<PORT_RTORRENT>|${PORT_RTORRENT}|g" -i /home/torrent/.rtorrent.rc

# Externalize rtorrent configuration
if [ -e /config/rtorrent/.rtorrent.rc ]; then
  ln -sf /config/rtorrent/.rtorrent.rc /home/torrent/.rtorrent.rc
else
  mv /home/torrent/.rtorrent.rc /config/rtorrent/.rtorrent.rc
  ln -s /config/rtorrent/.rtorrent.rc /home/torrent/.rtorrent.rc
fi

f_log SUC "done" # success of Generate configuration

f_log INF "HTTP authentication configuration... "

# Add http authentication
if [ "${HTTP_AUTH}" = true ]; then
  mkdir -p /config/nginx/passwd
  if [ ! -s /config/nginx/passwd/rutorrent_passwd ]; then
    f_log WRN "HTTP auth is active; run gen-http-passwd to provision the first user in /config/nginx/passwd/rutorrent_passwd"
  fi
  sed -e "s|<auth>|auth_basic \"rutorrent\";\n    auth_basic_user_file \"/config/nginx/passwd/rutorrent_passwd\";|g" -i /etc/nginx/nginx.conf
else
  sed "/<auth>/d" -i /etc/nginx/nginx.conf
fi

sed -e "s|<rpc2>|include /etc/nginx/rpc2-${rpc2_mode}.conf;|g" -i /etc/nginx/nginx.conf

if [ "${ENABLE_RPC2}" = true ] && [ "${HTTP_AUTH}" != true ]; then
  f_log WRN "RPC2 is enabled without HTTP authentication"
fi

if ! nginx -t; then
  f_log ERR "Invalid nginx configuration"
  exit 1
fi

f_log SUC "done" # success of HTTP authentication configuration

# Filebot configuration
if [ -e /filebot/filebot.sh ]; then
  f_log INF "Configuration of filebot... "
  mkdir -p /data/media /config/filebot

  # Externalize filebot data folder
  if [ -d /config/filebot/data ]; then
    rm -rf /filebot/data
    ln -s /config/filebot/data /filebot/data
  else
    mkdir -p /config/filebot/data
    rm -rf /filebot/data
    ln -s /config/filebot/data /filebot/data
  fi

  # Add license file
  if [ -z "${FILEBOT_LICENSE:-}" ] || [ ! -e "${FILEBOT_LICENSE}" ]; then
    f_log ERR "License filebot file does not exist"
    exit 1
  elif [ ! -e /filebot/data/.license ]; then
    /filebot/filebot.sh --license "${FILEBOT_LICENSE}"
  fi

  # Externalize args_amc.txt file
  if [ -e /config/filebot/args_amc.txt ]; then
    ln -sf /config/filebot/args_amc.txt /filebot/args_amc.txt
  else
    mv /filebot/args_amc.txt /config/filebot/args_amc.txt
    ln -s /config/filebot/args_amc.txt /filebot/args_amc.txt
  fi

  # Custom postdl script
  if [ -e /config/filebot/postdl ]; then
    ln -sf /config/filebot/postdl /usr/local/bin/postdl
  fi

  if [ -z "$(grep ^method.set_key.*event.download.finished,filebot /home/torrent/.rtorrent.rc)" ]; then
    echo 'method.set_key = event.download.finished,filebot,"execute.nothrow=/usr/local/bin/postdl,$d.base_path=,$d.name="' >> /home/torrent/.rtorrent.rc
  fi

  if [ -z "$(grep ^method.set_key.*event.download.erased,filebot_cleaner /home/torrent/.rtorrent.rc)" ]; then
    echo 'method.set_key = event.download.erased,filebot_cleaner,"execute.nothrow=/usr/local/bin/postrm"' >> /home/torrent/.rtorrent.rc
  fi

  find /filebot ! -user "${UID}" -exec chown -h "${UID}:${GID}" {} +
  chmod +x /usr/local/bin/postdl /usr/local/bin/postrm
  f_log SUC "done" # success of Configuration of filebot
fi

f_log INF "Update old configurations... "
if /usr/local/bin/update-config; then
  f_log SUC "done"
else
  update_status="$?"
  f_log ERR "Unable to update old configurations (exit ${update_status})"
  exit "${update_status}"
fi

f_log INF "Apply system permissions... "

f_log WRN "Skipping ruTorrent plugin chown; packaged release may differ"

for folder in /config /rutorrent /rutorrent/app/share/torrents /home/torrent /var/lib/nginx /var/log /etc/nginx /etc/php85 /tmp /etc/s6.d /run; do
  [ -e "${folder}" ] || continue
  find "${folder}" -path /config/rutorrent/.erasedata-first-use -prune -o \
    \( ! -user "${UID}" -o ! -group "${GID}" \) -exec chown -h "${UID}:${GID}" {} +
done

f_log SUC "done" # success of Apply system permissions

# set perm
chown "${UID}:${GID}" /data/.watch /data/.session "${DOWNLOAD_DIRECTORY}"

if [ "${CHECK_PERM_DATA}" = true ]; then
  f_log INF "Apply data permissions... "
  find /data \( ! -user "${UID}" -o ! -group "${GID}" \) -exec chown -h "${UID}:${GID}" {} +
  f_log SUC "done" # success of Apply data permissions
fi

rm -f /data/.session/rtorrent.lock

exec su-exec "${UID}":"${GID}" "$@"
