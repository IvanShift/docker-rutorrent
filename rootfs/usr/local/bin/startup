#!/usr/bin/env sh
set -eu
# Startup controls image configuration as root; each supervised daemon drops privileges.
umask 022
f_log() {
  log_type=$1
  log_message=$(printf '%s' "$2" | LC_ALL=C tr '\000-\037\177' '?')
  case "$log_type" in
    ERR|WRN) printf '[%s] %s\n' "$(date +%Y/%m/%d-%H:%M:%S)" "$log_message" >&2 ;;
    *) printf '[%s] %s\n' "$(date +%Y/%m/%d-%H:%M:%S)" "$log_message" ;;
  esac
}
invalid() { f_log ERR "$1"; exit 64; }
case "${UID:-}" in ''|*[!0-9]*) invalid 'UID must be a decimal number greater than zero' ;; esac
UID=$(printf '%s' "$UID" | sed 's/^0*//')
[ -n "$UID" ] || invalid 'UID must be a decimal number greater than zero'
[ "${#UID}" -le 10 ] && [ "$UID" -le 4294967294 ] || invalid 'UID must be between 1 and 4294967294'
export UID
case "${CHECK_PERM_DATA:-}" in true|false) ;; *) invalid 'CHECK_PERM_DATA must be exactly true or false' ;; esac
case "${ENABLE_RPC2:-}" in true) rpc2_mode=enabled ;; false) rpc2_mode=disabled ;; *) invalid 'ENABLE_RPC2 must be exactly true or false' ;; esac
case "${HTTP_AUTH:-}" in
  true) ;;
  false)
    [ "${ALLOW_UNAUTHENTICATED_HTTP:-false}" = true ] || invalid 'HTTP_AUTH=false requires ALLOW_UNAUTHENTICATED_HTTP=true; refusing unauthenticated access'
    # Separators match startup.php: commas and the whitespace that trim() drops.
    if [ -z "$(printf '%s' "${HTTP_ALLOWED_HOSTS:-}" | tr -d ' ,\t\n\r\v')" ]; then
      f_log WRN 'HTTP_AUTH=false accepts IP literals and localhost; DNS names require HTTP_ALLOWED_HOSTS=<name> at container creation, otherwise nginx returns 421'
    fi
    f_log WRN 'HTTP authentication is disabled by explicit opt-out; anyone reaching port 8080 can access tracker credentials and control torrents, including requests from an untrusted browser page'
    ;;
  *) invalid 'HTTP_AUTH must be exactly true or false' ;;
esac
RU_HTTP_AUTH=$HTTP_AUTH
if [ "${RU_FORBID_USER_SETTINGS+x}" = x ]; then
  case "$RU_FORBID_USER_SETTINGS" in true|false) ;; *) invalid 'RU_FORBID_USER_SETTINGS must be exactly true or false' ;; esac
else RU_FORBID_USER_SETTINGS=true; fi
export RU_HTTP_AUTH
if [ "${RU_FORBID_USER_SETTINGS+x}" = x ]; then export RU_FORBID_USER_SETTINGS; fi
for port_name in PORT_RTORRENT PORT_DHT; do
  case "$port_name" in PORT_RTORRENT) port_value=${PORT_RTORRENT:-} ;; PORT_DHT) port_value=${PORT_DHT:-} ;; esac
  case "$port_value" in ''|*[!0-9]*) invalid "$port_name must be a decimal port between 1 and 65535" ;; esac
  port_value=$(printf '%s' "$port_value" | sed 's/^0*//')
  [ -n "$port_value" ] && [ "${#port_value}" -le 5 ] && [ "$port_value" -le 65535 ] || invalid "$port_name must be a decimal port between 1 and 65535"
  case "$port_name" in PORT_RTORRENT) PORT_RTORRENT=$port_value ;; PORT_DHT) PORT_DHT=$port_value ;; esac
done
case "${MODE_DHT:-}" in off|on|auto|disable) ;; *) invalid 'MODE_DHT must be off, on, auto or disable' ;; esac
case "${PEER_EXCHANGE:-}" in yes|no) ;; *) invalid 'PEER_EXCHANGE must be yes or no' ;; esac
case "${DOWNLOAD_DIRECTORY:-}" in /*) ;; *) invalid 'DOWNLOAD_DIRECTORY must be an absolute directory path' ;; esac
case "$DOWNLOAD_DIRECTORY" in *'
'*) invalid 'DOWNLOAD_DIRECTORY is invalid: control characters are unsupported' ;; esac
if printf '%s' "$DOWNLOAD_DIRECTORY" | LC_ALL=C grep -q '[[:cntrl:]"]'; then invalid 'DOWNLOAD_DIRECTORY is invalid: quotes and control characters are unsupported'; fi
DOWNLOAD_DIRECTORY=$(printf '%s' "$DOWNLOAD_DIRECTORY" | sed 's|//*|/|g')
[ "$DOWNLOAD_DIRECTORY" = / ] || DOWNLOAD_DIRECTORY=${DOWNLOAD_DIRECTORY%/}
case "/$DOWNLOAD_DIRECTORY/" in */../*|*/./*) invalid 'DOWNLOAD_DIRECTORY is invalid: directory traversal is unsupported' ;; esac
# ruTorrent creates profile, temporary and log entries with this mask. The fork
# reads three or four octal digits; a mask without owner rwx breaks the service.
if [ "${RU_PROFILE_MASK+x}" = x ]; then
  case "$RU_PROFILE_MASK" in
    7[0-7][0-7]|07[0-7][0-7]) ;;
    *) invalid 'RU_PROFILE_MASK must be three or four octal digits that keep owner rwx, for example 0700 or 0750' ;;
  esac
fi
helper=/usr/local/lib/rutorrent/startup.php
native_actor_check=false
if [ ! -f /etc/rtorrent-legacy ]; then
  # The supervised native daemon uses these fixed image paths. Refuse an
  # unsupported override before any PHP interpreter or operator code runs.
  if [ "${RUTORRENT_NATIVE_PHP+x}" = x ] && [ "$RUTORRENT_NATIVE_PHP" != /usr/bin/php85 ]; then invalid 'RUTORRENT_NATIVE_PHP must be /usr/bin/php85 in this image'; fi
  if [ "${RUTORRENT_NATIVE_APP_ROOT+x}" = x ] && [ "$RUTORRENT_NATIVE_APP_ROOT" != /rutorrent/app ]; then invalid 'RUTORRENT_NATIVE_APP_ROOT must be /rutorrent/app in this image'; fi
  actor_marker=/usr/local/share/rutorrent-native-actor-paths-required
  if [ -e "$actor_marker" ] || [ -L "$actor_marker" ]; then
    [ ! -L "$actor_marker" ] && [ -f "$actor_marker" ] && [ "$(stat -c '%u:%a:%h' "$actor_marker")" = 0:644:1 ] || { f_log ERR 'Unsafe immutable native actor requirement marker; recreate the container'; exit 78; }
    native_actor_check=true
  elif [ -e /rutorrent/app/plugins/retrackers/dispatch.php ] || [ -L /rutorrent/app/plugins/retrackers/dispatch.php ] \
    || [ -e /rutorrent/app/plugins/autotools/move_worker.php ] || [ -L /rutorrent/app/plugins/autotools/move_worker.php ]; then native_actor_check=true; fi
fi
check_native_actors() {
  [ "$native_actor_check" = true ] || return 0
  actor_guard=/usr/local/libexec/native-actor-paths
  if [ ! -x "$actor_guard" ] || [ -L "$actor_guard" ]; then f_log ERR 'Native worker path checker is unavailable; recreate the container with an updated image'; exit 78; fi
  # Native actors execute as the service; PHP also bootstraps private image
  # configuration as root, so its fixed ancestors and leaf require root owner.
  if su-exec "$UID:$GID" "$actor_guard" check --require-all --bootstrap-root; then :
  else f_log ERR 'Cannot attest native worker paths before service startup; inspect the mounted image paths and their ownership, modes and types'; exit 78; fi
}
# Nginx substitution consumes its image placeholders. Container environment is
# creation-bound; refuse an incompatible manual rerun before changing services.
policy=/run/rutorrent-startup-http-policy
requested_policy="$HTTP_AUTH:$ENABLE_RPC2"
if [ -e "$policy" ] || [ -L "$policy" ]; then
  [ ! -L "$policy" ] && [ -f "$policy" ] && [ "$(stat -c '%u:%a:%h' "$policy")" = 0:600:1 ] || { f_log ERR 'Unsafe startup HTTP policy marker; recreate the container'; exit 78; }
  IFS= read -r previous_policy < "$policy" || { f_log ERR 'Invalid startup HTTP policy marker; recreate the container'; exit 78; }
  [ "$previous_policy" = "$requested_policy" ] || { f_log ERR 'HTTP_AUTH or ENABLE_RPC2 changed after initial startup; recreate the container with the intended environment'; exit 78; }
else
  # Keep the contract even if a later startup step fails after substitution.
  (umask 077; printf '%s\n' "$requested_policy" > "$policy")
  chmod 0600 "$policy"
fi
f_log INF 'Create torrent user...'
# getent casts a numeric key to gid_t, so 4294967296 would name root's group.
case "${GID:-}" in
  ''|*[!0-9]*) ;;
  *)
    GID=$(printf '%s' "$GID" | sed 's/^0*//')
    [ -n "$GID" ] || GID=0
    [ "${#GID}" -le 10 ] && [ "$GID" -le 4294967294 ] || invalid 'GID must be an existing group name or decimal group ID between 0 and 4294967294'
    ;;
esac
if ! getent group "$GID" >/dev/null; then
  case "$GID" in ''|*[!0-9]*) invalid 'GID must be an existing group name or decimal group ID' ;; esac
  if groupmod -g "$GID" torrent 2>/dev/null; then :
  else f_log ERR "Cannot configure service group GID=$GID; inspect the requested identity and container account database"; exit 78; fi
fi
# Resolve a group name once: services and helpers inherit only decimal IDs.
service_gid=$(getent group "$GID" | cut -d: -f3)
case "$service_gid" in ''|*[!0-9]*) f_log ERR "Cannot resolve service group GID=$GID; inspect the requested identity and container account database"; exit 78 ;; esac
GID=$service_gid
export GID
existing_user=$(getent passwd "$UID" | cut -d: -f1)
if [ -z "$existing_user" ]; then
  if usermod -u "$UID" -g "$GID" torrent 2>/dev/null; then :
  else f_log ERR "Cannot configure service account UID=$UID GID=$GID; inspect the requested identity and container account database"; exit 78; fi
elif [ "$existing_user" = torrent ]; then
  if usermod -g "$GID" torrent 2>/dev/null; then :
  else f_log ERR "Cannot configure service account UID=$UID GID=$GID; inspect the requested identity and container account database"; exit 78; fi
else f_log WRN "UID $UID already assigned to $existing_user; continuing with existing account"; fi
check_native_actors
mkdir -p /home/torrent
chown -h "$UID:$GID" /home/torrent
f_log INF 'Create volume folders...'
/usr/bin/php85 "$helper" config
f_log INF 'Generate configuration...'
/usr/bin/php85 "$helper" externalize
# Keep an immutable image default after the persisted rc has been deleted on restart.
rc_default=/usr/local/share/rutorrent-defaults/rtorrent.rc
if [ ! -e /config/rtorrent/.rtorrent.rc ] && [ ! -L /config/rtorrent/.rtorrent.rc ]; then
  # Only a value that seeds a new rc must name a directory below /data. startup.php
  # applies the same rule to a persisted directory.default.set, which then wins over
  # a different DOWNLOAD_DIRECTORY with a warning, as before this rule existed.
  case "$DOWNLOAD_DIRECTORY" in
    /data/?*) ;;
    *) invalid 'DOWNLOAD_DIRECTORY must be a directory below /data' ;;
  esac
  if [ ! -f "$rc_default" ]; then
    if [ -L /home/torrent/.rtorrent.rc ]; then f_log ERR 'Image rc default is missing; recreate the container with an updated image'; exit 78; fi
    rc_default=/home/torrent/.rtorrent.rc
  fi
  download_rc=$(printf '%s' "$DOWNLOAD_DIRECTORY" | sed 's/\\/\\\\/g')
  download_sed=$(printf '%s' "$download_rc" | sed 's/[\\&|]/\\&/g')
  if [ -r /proc/net/if_inet6 ] && IFS= read -r inet6_record < /proc/net/if_inet6 && [ -n "$inet6_record" ]; then block_ipv6=no; else block_ipv6=yes; fi
  temporary_path=''
  . /usr/local/libexec/atomic-file.sh
  temporary_path=$(mktemp /config/rtorrent/.rtorrent.rc.tmp.XXXXXX)
  sed -e "s|<DOWNLOAD_DIRECTORY>|$download_sed|g" -e "s|<MODE_DHT>|$MODE_DHT|g" \
    -e "s|<PORT_DHT>|$PORT_DHT|g" -e "s|<PEER_EXCHANGE>|$PEER_EXCHANGE|g" \
    -e "s|<PORT_RTORRENT>|$PORT_RTORRENT|g" -e "s|<BLOCK_IPV6>|$block_ipv6|g" \
    "$rc_default" > "$temporary_path"
  chmod 0644 "$temporary_path"
  mv -f "$temporary_path" /config/rtorrent/.rtorrent.rc
  temporary_path=''
fi
ln -sfn /config/rtorrent/.rtorrent.rc /home/torrent/.rtorrent.rc
paths=$(/usr/bin/php85 "$helper" paths)
session_path=$(printf '%s\n' "$paths" | sed -n '1p')
effective_download=$(printf '%s\n' "$paths" | sed -n '2p')
if [ "$DOWNLOAD_DIRECTORY" != "$effective_download" ]; then f_log WRN "DOWNLOAD_DIRECTORY differs from persisted directory.default.set; using $effective_download for both daemons; edit the persisted rc to change the default"; fi
DOWNLOAD_DIRECTORY=$effective_download
export DOWNLOAD_DIRECTORY
/usr/bin/php85 "$helper" session "$session_path"
/usr/bin/php85 "$helper" host-policy
f_log INF 'HTTP authentication configuration...'
if [ "$HTTP_AUTH" = true ]; then
  /usr/bin/php85 "$helper" auth
  su-exec "$UID:$GID" test -s /config/nginx/passwd/rutorrent_passwd || f_log WRN 'HTTP auth is active; run gen-http-passwd to provision the first user in /config/nginx/passwd/rutorrent_passwd'
  sed -e 's|<auth>|auth_basic "rutorrent";\n    auth_basic_user_file "/config/nginx/passwd/rutorrent_passwd";|g' -i /etc/nginx/nginx.conf
else sed '/<auth>/d' -i /etc/nginx/nginx.conf; fi
sed -e "s|<rpc2>|include /etc/nginx/rpc2-$rpc2_mode.conf;|g" -i /etc/nginx/nginx.conf
if [ "$ENABLE_RPC2" = true ] && [ "$HTTP_AUTH" != true ]; then f_log WRN 'RPC2 is enabled without HTTP authentication'; fi
# FileBot reads operator data and imports licenses only as the selected UID.
if [ -e /filebot/filebot.sh ]; then
  f_log INF 'Configuration of filebot...'
  /usr/bin/php85 "$helper" filebot
  if ! grep -q '^method.set_key.*event.download.finished,filebot' /home/torrent/.rtorrent.rc; then printf '%s\n' 'method.set_key = event.download.finished,filebot,"execute.nothrow=/usr/local/bin/postdl,$d.base_path=,$d.name="' >> /home/torrent/.rtorrent.rc; fi
  if ! grep -q '^method.set_key.*event.download.erased,filebot_cleaner' /home/torrent/.rtorrent.rc; then printf '%s\n' 'method.set_key = event.download.erased,filebot_cleaner,"execute.nothrow=/usr/local/bin/postrm"' >> /home/torrent/.rtorrent.rc; fi
fi
f_log INF 'Update old configurations...'
if PATH="/usr/bin:$PATH" /usr/local/bin/update-config; then f_log SUC 'done'
else update_status=$?; f_log ERR "Unable to update old configurations (exit $update_status)"; exit "$update_status"; fi
# FPM clears its environment. Preserve only known operator options that are set.
# Refer to variables by name so values never become pool configuration syntax.
{
  for pool in www health; do
    printf '[%s]\n' "$pool"
    for key in RU_LOG_FILE RU_PROFILE_PATH RU_PROFILE_MASK RU_TEMP_DIRECTORY RU_LOCALHOSTS RU_TRUSTED_ORIGINS RU_FORBID_USER_SETTINGS; do
      if printenv "$key" >/dev/null; then printf 'env[%s] = $%s\n' "$key" "$key"; fi
    done
  done
} > /etc/php85/php-fpm.d/runtime-env.conf
f_log INF 'Apply system permissions...'
mkdir -p /run/nginx /run/php /run/rtorrent /var/lib/nginx
chmod 0700 /run/nginx
# The listener survives SIGKILL in the writable image layer. Only a socket is
# stale state; an unexpected regular file or link must be inspected.
if [ -S /run/nginx/plugin-health.sock ] && [ ! -L /run/nginx/plugin-health.sock ]; then rm -f /run/nginx/plugin-health.sock
elif [ -e /run/nginx/plugin-health.sock ] || [ -L /run/nginx/plugin-health.sock ]; then f_log ERR 'Unexpected /run/nginx/plugin-health.sock type; inspect it before restarting'; exit 78; fi
/usr/bin/php85 "$helper" ownership "$session_path"
if [ -e /filebot/filebot.sh ]; then /usr/bin/php85 "$helper" filebot-hook; fi
# New helper manifests advertise the bounded, non-destructive filesystem probe.
if [ -f /usr/local/share/rutorrent-native-capabilities ] && grep -qx 'rename-probe=1' /usr/local/share/rutorrent-native-capabilities; then
  if timeout 5 su-exec "$UID:$GID" /usr/local/bin/rutorrent-erasedata-rename-noreplace --probe "$DOWNLOAD_DIRECTORY" >/dev/null 2>&1; then :
  else
    probe_status=$?
    # Names follow the one helper table, ErasedataFilesystemOps::RENAME_HELPER_STATUS
    # in the fork's plugins/erasedata/filesystem.php; a probe accepts 0 and 5.
    case "$probe_status" in
      1) probe_reason=rename-noreplace-collision ;;
      2) probe_reason=rename-noreplace-invalid-arguments ;;
      3) probe_reason=rename-noreplace-unsupported ;;
      4) probe_reason=rename-noreplace-error ;;
      5) probe_reason=rename-noreplace-fallback ;;
      *) probe_reason=rename-noreplace-process-exit-$probe_status ;;
    esac
    case "$probe_status" in
      5) f_log INF "Filesystem at $DOWNLOAD_DIRECTORY is using locked rename fallback ($probe_reason); rename-noreplace operations remain available" ;;
      3) f_log WRN "Filesystem at $DOWNLOAD_DIRECTORY does not support rename-noreplace ($probe_reason: a plain rename was refused too, or the probe saw an entry replaced); erasedata removal, datadir moves and AutoTools Move refuse work on this filesystem" ;;
      *) f_log WRN "Unable to check rename-noreplace at $DOWNLOAD_DIRECTORY ($probe_reason); erasedata, datadir and AutoTools Move check each actual filesystem before changing files" ;;
    esac
  fi
fi
/usr/bin/php85 "$helper" custom
# A stale custom-plugin manifest must not retire an already-required actor.
check_native_actors
if ! su-exec "$UID:$GID" nginx -t; then f_log ERR 'Invalid nginx configuration'; exit 1; fi
f_log SUC 'done'
rm -f /etc/s6.d/.s6-svscan/shutdown-requested /etc/s6.d/.s6-svscan/service-failed
exec "$@"
