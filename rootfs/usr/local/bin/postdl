#!/usr/bin/env sh
set -eu
# rTorrent waits for this completion hook, so it only queues the job for the
# filebot-queue service. Root invocations queue as the selected service.
if [ "$(id -u)" -eq 0 ]; then
  case "${UID:-}" in ''|*[!0-9]*) echo 'FileBot hook requires a configured non-root service identity' >&2; exit 78 ;; esac
  [ "${#UID}" -le 10 ] && [ "$UID" -gt 0 ] && [ "$UID" -le 4294967294 ] && [ -n "${GID:-}" ] || { echo 'FileBot hook requires a configured non-root service identity' >&2; exit 78; }
  exec su-exec "$UID:$GID" /usr/local/bin/postdl "$@"
fi
exec /usr/bin/php85 -n /usr/local/libexec/filebot-queue.php completion "${1:-}" "${2:-}"
