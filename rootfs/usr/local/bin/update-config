#!/usr/bin/env sh

set -eu
LC_ALL=C
export LC_ALL
. /usr/local/libexec/atomic-file.sh

if [ "$#" -gt 2 ]; then
  echo "Usage: $0 [RTORRENT_RC_PATH [RUTORRENT_PHP_CONFIG_PATH]]" >&2
  exit 64
fi

rtorrent_rc_path=${1:-/config/rtorrent/.rtorrent.rc}
rutorrent_php_config_path=${2:-/config/rutorrent/conf/config.php}
php_bin=''

find_php_bin() {
  if [ -z "${php_bin}" ]; then
    php_bin=$(command -v php85 || command -v php) || {
      echo 'Unable to migrate configuration; PHP CLI is unavailable' >&2
      return 1
    }
    UPDATE_PHP_PATH=${php_bin}
    export UPDATE_PHP_PATH
  fi
}

transform_rtorrent_rc() {
  rc_mode=native
  [ ! -f /etc/rtorrent-legacy ] || rc_mode=legacy
  "${php_bin}" -n /usr/local/libexec/migrate-rtorrent-config.php "$1" "$2" "${rc_mode}"
}

validate_rtorrent_rc() {
  # The transform checks literal daemon limits and unsupported legacy commands.
  # Arbitrary commands cannot be trial-loaded safely: rTorrent executes the rc.
  # Its real launch runs as the service user and propagates failure to s6.
  [ -f "$1" ]
}

transform_rutorrent_php_config() {
  "${php_bin}" -n -d extension=tokenizer.so /usr/local/libexec/migrate-rutorrent-config.php "$1" "$2"
}

validate_rutorrent_php_config() {
  if "${php_bin}" -n -l "$1" >"${temporary_directory}/lint-output" 2>&1; then
    return 0
  fi
  echo "Invalid transformed ruTorrent PHP configuration for $2:" >&2
  "${php_bin}" -n -r 'echo str_replace($argv[1], $argv[2] . " (transformed)", file_get_contents($argv[3]));' \
    "$1" "$2" "${temporary_directory}/lint-output" >&2
  return 1
}

atomic_update() {
  target=$1
  transform=$2
  validator=$3
  label=$4
  case ${target} in /*) ;; *) target=./${target} ;; esac

  if [ -L "${target}" ]; then
    echo "Refusing to update ${label}; ${target} is a symbolic link" >&2
    return 1
  fi
  if [ ! -e "${target}" ]; then
    echo "Skip ${label}; ${target} not found"
    return 0
  fi
  if [ ! -f "${target}" ]; then
    echo "Unable to update ${label}; ${target} is not a regular file" >&2
    return 1
  fi
  if ! original_metadata=$(stat -c '%a:%u:%g:%d:%i' "${target}"); then
    echo "Unable to read mode and ownership for ${label}: ${target}" >&2
    return 1
  fi
  original_mode=${original_metadata%%:*}
  original_owner=${original_metadata#*:}
  original_uid=${original_owner%%:*}
  original_owner=${original_owner#*:}
  original_gid=${original_owner%%:*}
  find_php_bin || return 1
  # Inspection also works when the target's directory is read-only. No sibling
  # file is created unless the validated result differs from the original.
  if ! temporary_directory=$(mktemp -d /tmp/update-config.XXXXXX); then
    temporary_directory=''
    echo "Unable to create temporary directory for ${label}: ${target}" >&2
    return 1
  fi
  snapshot=${temporary_directory}/original
  candidate=${temporary_directory}/candidate
  if ! cp "${target}" "${snapshot}" || ! cp "${snapshot}" "${candidate}"; then
    echo "Unable to copy ${label} for migration: ${target}" >&2
    return 1
  fi
  operation_status=0
  "${transform}" "${candidate}" "${target}" >"${temporary_directory}/migration-output" || operation_status=$?
  if [ "${operation_status}" -ne 0 ]; then
    echo "Unable to transform ${label}: ${target}" >&2
    return "${operation_status}"
  fi
  "${validator}" "${candidate}" "${target}" || operation_status=$?
  if [ "${operation_status}" -ne 0 ]; then
    echo "Unable to validate ${label}: ${target}" >&2
    return "${operation_status}"
  fi
  compare_status=0
  cmp -s "${snapshot}" "${candidate}" || compare_status=$?
  case ${compare_status} in
    0) atomic_cleanup; return 0 ;;
    1) ;;
    *) echo "Unable to compare transformed ${label}: ${target}" >&2; return "${compare_status}" ;;
  esac
  if [ "$(stat -c '%a:%u:%g:%d:%i' "${target}")" != "${original_metadata}" ] || ! cmp -s "${target}" "${snapshot}"; then
    echo "Configuration changed during migration: ${target}" >&2
    return 1
  fi
  mount_status=0
  "${php_bin}" -n /usr/local/libexec/config-file-commit.php is-mounted "${target}" || mount_status=$?
  case ${mount_status} in
    0)
      "${php_bin}" -n -d extension=pcntl.so /usr/local/libexec/config-file-commit.php write-mounted "${target}" "${candidate}" "${snapshot}" "${original_metadata}" || return "$?"
    ;;
    1)
      if ! temporary_path=$(mktemp "${target}.tmp.XXXXXX"); then
        temporary_path=''
        echo "Configuration requires migration but its directory is not writable: ${target}" >&2
        return 1
      fi
      if ! cp "${candidate}" "${temporary_path}"; then
        echo "Unable to stage transformed ${label}: ${target}" >&2
        return 1
      fi
      if ! chown "${original_uid}:${original_gid}" "${temporary_path}" || ! chmod "${original_mode}" "${temporary_path}"; then
        echo "Unable to restore mode and ownership on temporary ${label}: ${target}" >&2
        return 1
      fi
      if ! mv -f "${temporary_path}" "${target}"; then
        echo "Unable to replace ${label}: ${target}" >&2
        return 1
      fi
      temporary_path=''
    ;;
    *) echo "Unable to inspect configuration mount: ${target}" >&2; return "${mount_status}" ;;
  esac
  cat "${temporary_directory}/migration-output"
  echo "Updated ${label}: ${target}"
  atomic_cleanup
}

atomic_update "${rtorrent_rc_path}" transform_rtorrent_rc validate_rtorrent_rc 'rTorrent configuration'
atomic_update "${rutorrent_php_config_path}" transform_rutorrent_php_config validate_rutorrent_php_config 'ruTorrent PHP configuration'
