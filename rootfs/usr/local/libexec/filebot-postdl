#!/usr/bin/env sh
set -eu
# One queued completion. filebot-queue runs it as the service UID in its own
# session; an executable operator hook replaces the packaged AMC call.
if [ "$(id -u)" -eq 0 ]; then echo 'FileBot jobs run only as the service UID; queue them with postdl' >&2; exit 78; fi
custom=/config/filebot/postdl
if [ -f "$custom" ] && [ ! -L "$custom" ] && [ -x "$custom" ]; then exec "$custom" "$@"; fi
exec /filebot/filebot.sh \
  --lang "${FILEBOT_LANG}" \
  -script fn:amc \
  --output /data/media \
  --action "${FILEBOT_RENAME_METHOD}" \
  --conflict "${FILEBOT_CONFLICT}" \
  -non-strict \
  --log-file /tmp/filebot-amc.log \
  --def @/filebot/args_amc.txt \
  --def ut_dir="${1:-}" \
  --def ut_title="${2:-}" 2>> /tmp/filebot-error.log
