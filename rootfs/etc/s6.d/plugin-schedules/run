#!/usr/bin/env sh
# Re-register the ruTorrent plugin schedules once, after a restart.
#
# rTorrent holds `schedule` entries in memory only. ruTorrent creates them from
# php/getplugins.php, which require_once's every enabled plugin's init.php --
# and that runs on a FULL page load, nothing else. An already-open tab polling
# httprpc does not do it. So when this container restarts, every plugin
# schedule is gone until somebody opens the panel: no error, no log line, just
# hours of nothing happening. Observed 2026-08-26, three hourly cycles missed.
#
# Deliberately once and only once. Re-registering an existing key makes
# rTorrent delete the entry and re-arm a fresh countdown, so calling this on a
# timer would keep pushing the next run further away -- the very bug it exists
# to avoid.
set -u
if [ "$(id -u)" = 0 ] && [ "${UID:-991}" != 0 ]; then
    exec su-exec "${UID:-991}:${GID:-991}" "$0" "$@"
fi
LOG_TAG="plugin-schedules"
URL="http://localhost/healthz-plugins"
response_file=''
cleanup() { [ -z "$response_file" ] || rm -f "$response_file"; }
trap cleanup EXIT
trap 'exit 0' TERM INT
log() { echo "[$(date '+%Y/%m/%d-%H:%M:%S')] ${LOG_TAG}: $*"; }
pause() {
    wait_seconds=$1
    [ "$wait_seconds" -le 3 ] || wait_seconds=3
    [ "$wait_seconds" -gt 0 ] || return 0
    sleep "$wait_seconds" &
    wait "$!"
}

# Session loading precedes plugin initialization. Its budget is independent from
# the registration retry window, and a listening socket is insufficient proof.
readiness_deadline=$(( $(date +%s) + 600 ))
ready=0
while [ "$(date +%s)" -lt "$readiness_deadline" ]; do
    remaining=$(( readiness_deadline - $(date +%s) ))
    [ "$remaining" -gt 0 ] || break
    readiness_timeout=$remaining
    [ "$readiness_timeout" -le 3 ] || readiness_timeout=3
    if timeout "$readiness_timeout" /usr/bin/php85 /usr/local/libexec/rtorrent-ready.php >/dev/null 2>&1; then
        ready=1
        break
    fi
    remaining=$(( readiness_deadline - $(date +%s) ))
    pause "$remaining"
done

registered=0
if [ "$ready" -eq 1 ]; then
    deadline=$(( $(date +%s) + 300 ))
    response_file=$(mktemp /tmp/plugin-schedules.XXXXXX) || exit 1
    while [ "$(date +%s)" -lt "$deadline" ]; do
        remaining=$(( deadline - $(date +%s) ))
        [ "$remaining" -gt 0 ] || break
        request_timeout=$remaining
        [ "$request_timeout" -le 120 ] || request_timeout=120
        if curl --noproxy '*' --unix-socket /run/nginx/plugin-health.sock -fsS \
            -o "$response_file" --connect-timeout 2 --max-time "$request_timeout" "$URL" 2>/dev/null \
            && grep -Eq 'started[[:space:]]*:[[:space:]]*true' "$response_file" \
            && ! grep -Eq 'started[[:space:]]*:[[:space:]]*false' "$response_file"; then
            # Initialization has already run for every enabled plugin. Retrying
            # cannot repair a failed requirement and re-arms working schedules.
            if grep -Fq 'pluginCantStart' "$response_file"; then
                failed_plugins=$(grep -oE "[A-Za-z0-9_-]+:[[:space:]]*['\"][[:space:]]*\\+[[:space:]]*theUILang\\.pluginCantStart" "$response_file" \
                    | sed 's/:.*//' | sort -u | tr '\n' ' ')
                log "plugin initialization reported failed requirements plugins=${failed_plugins:-unknown}; inspect the web interface"
            fi
            registered=1
            break
        fi
        remaining=$(( deadline - $(date +%s) ))
        [ "$remaining" -gt 0 ] || break
        pause "$remaining"
    done
fi
cleanup
response_file=''

if [ "$registered" -eq 1 ]; then
    log "plugin schedules registered"
elif [ "$ready" -eq 0 ]; then
    log "rTorrent did not answer SCGI within 600s; plugin schedules were not registered"
else
    log "could not register plugin schedules via ${URL} within 300s after rTorrent became ready -- open the web interface once to create them"
fi

# The finish script marks successful one-shot initialization wanted-down.
[ "$registered" -eq 1 ]
